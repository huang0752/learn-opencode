flowchart TD
    DB[("OpenCode SQLite")]
    DB --> E["事件坐标"]
    DB --> P["会话读取模型"]
    DB --> R["恢复所需的运行状态"]
    E --> Q["event_sequence<br/>聚合序号与 replay owner"]
    E --> L["event<br/>按配置保留历史事件载荷"]
    P --> S["session_v2<br/>元信息与执行状态"]
    P --> I["session_inbox<br/>等待交付的输入"]
    P --> M["session_message<br/>已投影的会话消息"]
    M --> A["session_part<br/>可选的助手子项表示"]
    R --> C["session_v2<br/>time_suspended / resume_attempts"]
    R --> J["job<br/>仍在执行或等待投递的通知"]
    P --> B["blob / blob_ref<br/>可选的媒体存储与引用"]
